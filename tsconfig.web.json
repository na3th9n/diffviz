{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    // Vite does the bundling; tsc only type-checks the frontend.
    "noEmit": true
  },
  "include": ["src/web", "src/shared"]
}
