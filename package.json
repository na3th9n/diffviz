{
  "name": "diffviz",
  "version": "0.0.0",
  "description": "Visualize the changes a coding agent makes to a TypeScript project, live from git.",
  "type": "module",
  "bin": {
    "diffviz": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/shared src/server/cli.ts --dev --no-open",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
