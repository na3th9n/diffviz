{
  "name": "diffviz",
  "version": "1.0.0",
  "description": "Graph the changes a coding agent makes to a TypeScript project, live from git, labelled with the agent's own description.",
  "keywords": [
    "claude-code",
    "coding-agent",
    "git",
    "diff",
    "visualization",
    "typescript",
    "dependency-graph"
  ],
  "license": "MIT",
  "homepage": "https://github.com/na3th9n/diffviz#readme",
  "bugs": {
    "url": "https://github.com/na3th9n/diffviz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/na3th9n/diffviz.git"
  },
  "type": "module",
  "bin": {
    "diffviz": "dist/server/cli.js"
  },
  "files": [
    "dist/server",
    "dist/shared",
    "dist/web"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/shared src/server/cli.ts --dev --no-open",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build:site": "vite build --config vite.site.config.ts",
    "record-demo": "node scripts/record-demo.ts cdacc73 a66bc93 site/demo/recording/current.json site/demo/recording/session.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "express": "^5.3.0",
    "simple-git": "^4.1.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^13.0.2",
    "elkjs": "^0.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
